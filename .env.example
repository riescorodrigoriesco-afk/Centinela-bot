# Token del bot (Discord Developer Portal → Bot → Reset Token). Es una contraseña: no lo compartas.
DISCORD_BOT_TOKEN=

# Application ID (Discord Developer Portal → General Information → Application ID)
CLIENT_ID=

# Cadena de conexión de Postgres (host que te la dé: Render, Railway, etc.)
DATABASE_URL=

# Clave de la API FUT-DB (opcional). Sin ella, o si falla, el bot usa cartas de prueba automáticamente.
FUTDB_API_KEY=

# Opcional: si FUT-DB no está en la URL de siempre, indícala aquí.
FUTDB_BASE_URL=https://futdb.app/api

# Opcional: ID numérico de un servidor para registrar los comandos ahí al instante mientras pruebas.
DEV_GUILD_ID=
